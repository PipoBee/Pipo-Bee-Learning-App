# =============================================================================
# Pipo Bee — Admin / Web (Vite) — set these in Vercel / Cloudflare / Netlify
# Prefix VITE_ is required for client exposure.
# Never put SUPABASE_SECRET_KEY or service-role keys here.
# =============================================================================

# Supabase project URL (Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase publishable / anon key (Settings → API) — safe for browser
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Optional: Nest API base if the admin panel calls /api through a full URL
# Leave unset if you proxy /api to the API host in the hosting platform
# VITE_API_BASE_URL=https://api.your-domain.com/api/v1
