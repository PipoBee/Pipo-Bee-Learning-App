# =============================================================================
# Pipo Bee — Mobile (Expo) — set in EAS Secrets / eas.json production.env
# Only EXPO_PUBLIC_* is available in the client bundle.
# =============================================================================

# Nest API (required in production builds)
EXPO_PUBLIC_API_BASE_URL=https://api.your-domain.com/api/v1

# Cloud speech via API (optional)
EXPO_PUBLIC_AZURE_SPEECH_ENABLED=false

# Supabase Auth (if/when the mobile app uses the same auth as web)
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
