# =============================================================================
# Pipo Bee — API (NestJS) — set these on Railway / Render / Fly / Cloud Run
# Never commit real secrets. Copy to apps/api/.env for local use.
# =============================================================================

# --- Server ---
PORT=3000
# Public URL of this API (used for local upload links)
API_PUBLIC_URL=https://api.your-domain.com
# Browser origins allowed to call the API (comma-separated in production)
# Code currently enables CORS with *; tighten before go-live.
CORS_ORIGIN=https://app.your-domain.com,http://localhost:5173

# --- Database (Prisma) ---
# Prefer Supabase pooler for DATABASE_URL and direct for migrations
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
# Optional alias used by some scripts / MCP
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- JWT (Nest admin/legacy auth; generate a long random secret) ---
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- Supabase (server-side) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
# Service role / secret key — SERVER ONLY, never expose to Vite
SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# --- File storage ---
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
# When STORAGE_DRIVER=s3 or r2 (future / production assets):
# S3_BUCKET_NAME=pipo-bee-assets
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_CDN_URL=https://cdn.your-domain.com

# --- Azure Speech (pronunciation / STT fallback) ---
AZURE_SPEECH_ENABLED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
